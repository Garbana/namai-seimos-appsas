# index.html niekada nekešuojamas: jame įrašyti JS ir CSS failų vardai, tad
# įstrigęs senas HTML reiškia arba seną appso versiją, arba tuščią ekraną, jei
# tų failų nebėra. Patys failai turi turinio maišą varde, tad kešuojasi ilgai.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
